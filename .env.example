# LLM provider: "openrouter" (free models, current default) or "anthropic" (later)
# "openrouter" | "anthropic" | "stub".
# stub = deterministic offline responses: no key, no network, instant. Use it to
# work on the interface and the study flow without waiting on a free-tier model.
LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai) — used while # "openrouter" | "anthropic" | "stub".
# stub = deterministic offline responses: no key, no network, instant. Use it to
# work on the interface and the study flow without waiting on a free-tier model.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Free-tier model. Nemotron 3 Super balances instruction-following, reasoning,
# and structured output; Gemma 4 31B is a good faster fallback. Browse the live
# free list at https://openrouter.ai/models?max_price=0
# Measured on this project: nano-30b ~5s per section, super-120b ~70s (which
# overran the one-click timeout). Prefer a small model unless output quality
# for the study demands otherwise.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Anthropic Messages API — used while LLM_PROVIDER=anthropic. Server-side only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Prisma SQLite database
DATABASE_URL="file:./dev.db"

# In-place PDF editing is ON by default: accepted changes are redacted out of
# the uploaded file with MuPDF and the replacement drawn into the space they
# occupied, so the author's own design survives. Every output is verified and
# falls back to the clean template if it fails. Set this to false to force the
# fallback for every PDF.
# PDF_INPLACE_EDIT=false

# The external comparative feedback form shown at the end of a guided study
# session. Without it the handoff page still records that the participant
# reached it, and tells them to ask the researcher for the link.
#
# Responses have to be joinable to what the participant did in the app. Put
# {code} in the URL where the participant code belongs and it is filled in
# automatically — in Microsoft Forms, use "Collect responses" -> "Get pre-filled
# URL", answer the participant-code question with the word CODE, copy the link,
# and replace CODE with {code}. Without the placeholder the code is shown on
# screen for the participant to type as the form's first answer.
# STUDY_FEEDBACK_FORM_URL=
